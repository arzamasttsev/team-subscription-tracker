# Скопируйте в .env и при необходимости измените. Секретов в демоверсии нет.
# Порт на 127.0.0.1, на котором открывается приложение.
APP_PORT=8226
# 1 — показывать демо-входы на экране входа и разрешить /api/demo/reset. Для публичной версии — 0.
DEMO_MODE=1
# 1 — создать демоданные при старте (повторный запуск не дублирует данные). Для публичной версии — 0.
SEED_DEMO=1
# 1 — cookie сессии только по HTTPS. Для публичной версии за HTTPS — 1.
COOKIE_SECURE=0
# Часовой пояс команды в часах от UTC: от него считается «сегодня» для дат продления и платежей. По умолчанию 3 (МСК).
TZ_OFFSET_HOURS=3
